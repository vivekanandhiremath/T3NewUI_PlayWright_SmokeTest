[
  {
    "name": "Test Results",
    "messageRegex": ".*",
    "matchedStatuses": [
      "failed",
      "broken",
      "passed",
      "skipped"
    ]
  },
  {
    "name": "Broken Tests",
    "messageRegex": ".*error.*|.*exception.*",
    "matchedStatuses": [
      "broken"
    ]
  },
  {
    "name": "Failed Tests",
    "messageRegex": ".*fail.*",
    "matchedStatuses": [
      "failed"
    ]
  },
  {
    "name": "Passed Tests",
    "matchedStatuses": [
      "passed"
    ]
  },
  {
    "name": "Skipped Tests",
    "matchedStatuses": [
      "skipped"
    ]
  }
]
